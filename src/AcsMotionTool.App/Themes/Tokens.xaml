<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 颜色 ================= -->
    <Color x:Key="Color.Bg">#FFF3F5F9</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface2">#FFF8FAFC</Color>
    <Color x:Key="Color.Surface3">#FFEEF2F7</Color>
    <Color x:Key="Color.Border">#FFE4E8EF</Color>
    <Color x:Key="Color.BorderStrong">#FFD3DAE4</Color>
    <Color x:Key="Color.Text">#FF121A26</Color>
    <Color x:Key="Color.Text2">#FF57657A</Color>
    <Color x:Key="Color.Text3">#FF8B97A8</Color>
    <Color x:Key="Color.Brand">#FF1B6AC9</Color>
    <Color x:Key="Color.BrandDark">#FF1557A8</Color>
    <Color x:Key="Color.BrandSoft">#FFEAF2FD</Color>
    <Color x:Key="Color.Ok">#FF0F7B3D</Color>
    <Color x:Key="Color.OkSoft">#FFE6F4EB</Color>
    <Color x:Key="Color.Warn">#FFA85B00</Color>
    <Color x:Key="Color.WarnSoft">#FFFDF1E0</Color>
    <Color x:Key="Color.Danger">#FFD0342C</Color>
    <Color x:Key="Color.DangerSoft">#FFFCEAE8</Color>
    <Color x:Key="Color.Info">#FF0A6A9E</Color>

    <!-- ================= 画刷 ================= -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Color.Surface3}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Color.Text2}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Color.Text3}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource Color.BrandDark}" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource Color.BrandSoft}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource Color.OkSoft}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Color.Info}" />

    <!-- 选中/悬浮的半透明覆盖 -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#1A000000" />

    <!-- ================= 字体 ================= -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ================= 图标（16px 线性，Stroke 绘制） ================= -->
    <Geometry x:Key="IconAxis">M3,7 H21 M3,12 H14 M3,17 H9</Geometry>
    <Geometry x:Key="IconIo">M3,5 H21 V9 H3 Z M3,15 H21 V19 H3 Z</Geometry>
    <Geometry x:Key="IconVariable">M9,5 L4,12 L9,19 M15,5 L20,12 L15,19</Geometry>
    <Geometry x:Key="IconTerminal">M4,6 L10,12 L4,18 M12,18 H20</Geometry>
    <Geometry x:Key="IconProgram">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19</Geometry>
    <Geometry x:Key="IconLog">M4,6 H20 M4,12 H20 M4,18 H13</Geometry>
    <Geometry x:Key="IconSettings">M12,2.6 L20.2,7.3 V16.7 L12,21.4 L3.8,16.7 V7.3 Z M12,8.7 A3.3,3.3 0 1 0 12,15.3 A3.3,3.3 0 1 0 12,8.7</Geometry>
    <Geometry x:Key="IconWarning">M12,4 L21,20 H3 Z M12,10 V14.5 M12,17.2 V17.3</Geometry>
    <Geometry x:Key="IconCheck">M4,12.5 L9.5,18 L20,6.5</Geometry>

    <!-- ================= 状态圆点 ================= -->

    <!-- ================= 常用文字样式 ================= -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="HintWarnText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    </Style>


    <Style x:Key="MonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>

</ResourceDictionary>
