<Window x:Class="AcsMotionTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AcsMotionTool.App.Views"
        Title="ACS 运动控制调试工具 (SPiiPlus .NET)"
        Height="900" Width="1460" MinHeight="680" MinWidth="1080"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶栏：设备状态 + 全局急停 ===================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource BrandBrush}">
                        <Path Data="{StaticResource IconAxis}" Stroke="White" StrokeThickness="1.6"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACS 运动控制调试工具" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="SPiiPlus · .NET 8" FontSize="11" Foreground="{StaticResource Text3Brush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="22" Background="{StaticResource LineBrush}"
                        Margin="18,0" VerticalAlignment="Center" />

                <!-- 状态胶囊 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0" ToolTip="{Binding ConnectionStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Text3Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="已连接" Margin="6,0,0,0" FontSize="12"
                                       Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding Connection.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="未连接" Margin="6,0,0,0" FontSize="12"
                                       Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"
                                       Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center">
                            <Run Text="轴数 " Foreground="{StaticResource Text3Brush}" />
                            <Run Text="{Binding Axis.Axes.Count, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0" ToolTip="{Binding Connection.DbStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Connection.DbStatusText}" Margin="6,0,0,0" FontSize="12"
                                       MaxWidth="230" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Pill}" ToolTip="{Binding PollHealthText}">
                        <TextBlock Text="{Binding Connection.PollIntervalMs, StringFormat='轮询 {0} ms'}" FontSize="12"
                                   Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 全局急停 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonDanger}" Height="34" Padding="14,0"
                            Command="{Binding Axis.EmergencyStopAllCommand}"
                            AutomationProperties.AutomationId="EmergencyStopAll"
                            ToolTip="以急停减速度立即停止所有轴">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}" Stroke="White" StrokeThickness="1.8"
                                  Width="14" Height="14" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="全部急停" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 主体：左侧导航 + 页面 ===================== -->
        <TabControl Grid.Row="1" Style="{StaticResource NavTabControl}">
            <TabItem Header="轴控制" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconAxis}">
                <views:AxisView DataContext="{Binding Axis}" />
            </TabItem>
            <TabItem Header="IO" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconIo}">
                <views:IoView DataContext="{Binding Io}" />
            </TabItem>
            <TabItem Header="变量" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconVariable}">
                <views:VariableView DataContext="{Binding Variables}" />
            </TabItem>
            <TabItem Header="命令终端" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconTerminal}">
                <views:TerminalView DataContext="{Binding Terminal}" />
            </TabItem>
            <TabItem Header="程序缓冲区" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconProgram}">
                <views:ProgramView DataContext="{Binding Program}" />
            </TabItem>
            <TabItem Header="日志" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconLog}">
                <views:LogView DataContext="{Binding Logs}" />
            </TabItem>
            <TabItem Header="连接与设置" Style="{StaticResource NavTabItem}" Tag="{StaticResource IconSettings}">
                <views:ConnectionView DataContext="{Binding Connection}" />
            </TabItem>
        </TabControl>

        <!-- ===================== 状态栏 ===================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="就绪" Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource Text3Brush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="11.5"
                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center">
                    <Run Text="{Binding SelectedAxisName, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,16,0" FontSize="11.5"
                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"
                           Text="{Binding PollHealthText}" />

                <TextBlock Grid.Column="3" FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                           VerticalAlignment="Center"
                           Text="ACS.SPiiPlusNET 4.0.0 · .NET 8 · x64" />
            </Grid>
        </Border>
    </Grid>
</Window>
