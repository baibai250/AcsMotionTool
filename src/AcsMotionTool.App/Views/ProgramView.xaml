<UserControl x:Class="AcsMotionTool.App.Views.ProgramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="程序缓冲区" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="上传 / 下载 / 编译 / 运行控制器内的 ACSPL+ 程序" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" Text="缓冲区操作" />
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="下载会先清空该缓冲区再写入（覆盖）" />
                    </Grid>
                </Border>

                <WrapPanel Margin="14,10">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="缓冲区号" />
                        <TextBox Width="72" Margin="0,4,0,0"
                                 Text="{Binding BufferIndex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button VerticalAlignment="Bottom" Content="上传（读取）" Command="{Binding UploadCommand}" MinWidth="108" Margin="0,0,6,0" />
                    <Button VerticalAlignment="Bottom" Content="下载（覆盖）" Command="{Binding DownloadCommand}"
                            Style="{StaticResource ButtonDangerOutline}" MinWidth="108" Margin="0,0,6,0" />
                    <Button VerticalAlignment="Bottom" Content="编译" Command="{Binding CompileCommand}" MinWidth="72" Margin="0,0,6,0" />
                    <Button VerticalAlignment="Bottom" Content="运行" Command="{Binding RunCommand}" Style="{StaticResource ButtonPrimary}"
                            MinWidth="72" Margin="0,0,6,0" />
                    <Button VerticalAlignment="Bottom" Content="停止" Command="{Binding StopCommand}" MinWidth="72" Margin="0,0,16,0" />
                    <Button VerticalAlignment="Bottom" Content="插入回零模板" Command="{Binding InsertTemplateCommand}"
                            Style="{StaticResource ButtonSubtle}" MinWidth="112" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 编辑器 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" Text="程序文本" />
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="控制器只接受 ASCII · 注释符是 !" />
                    </Grid>
                </Border>

                <TextBox Text="{Binding ProgramText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="{StaticResource MonoFont}" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="12,10" Background="Transparent"
                         VerticalContentAlignment="Top" MinHeight="220" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
