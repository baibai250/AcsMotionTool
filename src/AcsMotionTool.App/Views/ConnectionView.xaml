<UserControl x:Class="AcsMotionTool.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="连接与设置" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="通讯、轴数量 / IO 规模、MySQL 软限位持久化" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左：连接 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="控制器连接" />
                                    <Border Style="{StaticResource ChipOk}" HorizontalAlignment="Right"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="已连接" FontSize="11.5" Foreground="{StaticResource OkBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="14,12">
                                <CheckBox Content="使用 SPiiPlus 模拟器（无需硬件）" IsChecked="{Binding UseSimulator}" />

                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="控制器 IP" />
                                        <TextBox Width="160" Margin="0,4,0,0"
                                                 IsEnabled="{Binding UseSimulator, Converter={StaticResource InverseBooleanConverter}}"
                                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="超时 (ms)" />
                                        <TextBox Width="96" Margin="0,4,0,0"
                                                 Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="轮询间隔 (ms)" />
                                        <TextBox Width="96" Margin="0,4,0,0"
                                                 Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="通讯协议" Margin="0,12,0,0" />
                                <Border Style="{StaticResource SegRadioGroup}" Margin="0,6,0,0"
                                        IsEnabled="{Binding UseSimulator, Converter={StaticResource InverseBooleanConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegRadio}" Content="UDP 点对点 (700)" GroupName="Protocol"
                                                     IsChecked="{Binding ProtocolIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" />
                                        <RadioButton Style="{StaticResource SegRadio}" Content="TCP 流 (701)" GroupName="Protocol"
                                                     IsChecked="{Binding ProtocolIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="连接后重启控制器" IsChecked="{Binding RebootAfterConnect}" />
                                    <CheckBox Content="初始化时自动连接控制器" IsChecked="{Binding AutoConnectOnStartup}" Margin="0,4,0,0" />
                                </StackPanel>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="连接" Command="{Binding ConnectCommand}"
                                            Style="{StaticResource ButtonPrimary}" MinWidth="88" Margin="0,0,8,0" />
                                    <Button Content="断开" Command="{Binding DisconnectCommand}" MinWidth="88" Margin="0,0,8,0" />
                                    <Button Content="读取控制器信息" Command="{Binding RefreshInfoCommand}" MinWidth="120" Margin="0,0,8,0" />
                                    <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" MinWidth="92" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Style="{StaticResource CardTitle}" Text="控制器信息" />
                            </Border>
                            <TextBlock Text="{Binding ControllerInfoText}" TextWrapping="Wrap"
                                       Margin="14,12" FontSize="12" LineHeight="20" Foreground="{StaticResource Text2Brush}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：设备 + 数据库 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Style="{StaticResource CardTitle}" Text="设备与规模" />
                            </Border>
                            <StackPanel Margin="14,12">
                                <WrapPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="轴数量" />
                                        <TextBox Width="80" Margin="0,4,0,0"
                                                 Text="{Binding AxisCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="IO 端口数" />
                                        <TextBox Width="80" Margin="0,4,0,0"
                                                 Text="{Binding IoPortCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="每端口位数" />
                                        <TextBox Width="88" Margin="0,4,0,0"
                                                 Text="{Binding IoBitsPerPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="应用（重建轴列表）" Command="{Binding ApplyAxisCountCommand}" MinWidth="150" Margin="0,0,8,0" />
                                    <Button Content="应用（重建 IO）" Command="{Binding ApplyIoLayoutCommand}" MinWidth="120" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="重启控制器" Command="{Binding RebootCommand}" Margin="0,0,8,0" />
                                    <Button Content="参数保存到 Flash" Command="{Binding SaveToFlashCommand}" MinWidth="128" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                           Text="重启控制器会断开当前连接，需要重新连接；保存 Flash 期间不要断电。" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="数据库（MySQL）" />
                                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Text="{Binding DbStatusText}"
                                               MaxWidth="260" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DbStatusText}" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="14,12">
                                <CheckBox Content="启用数据库保存软限位" IsChecked="{Binding DbEnabled}" />

                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="服务器" />
                                        <TextBox Width="130" Margin="0,4,0,0"
                                                 Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="端口" />
                                        <TextBox Width="72" Margin="0,4,0,0"
                                                 Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>

                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="用户" />
                                        <TextBox Width="120" Margin="0,4,0,0"
                                                 Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="密码" />
                                        <TextBox Width="120" Margin="0,4,0,0"
                                                 Text="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="库名" />
                                        <TextBox Width="120" Margin="0,4,0,0"
                                                 Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Margin="0,10,0,0">
                                    <CheckBox Content="应用软限位时自动写库" IsChecked="{Binding DbAutoSave}" />
                                    <CheckBox Content="启动时从数据库加载" IsChecked="{Binding DbLoadOnStartup}" Margin="0,4,0,0" />
                                </StackPanel>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="测试连接" Command="{Binding TestDatabaseCommand}" MinWidth="92" Margin="0,0,8,0" />
                                    <Button Content="初始化（建库建表）" Command="{Binding InitializeDatabaseCommand}" MinWidth="148" Margin="0,0,8,0" />
                                    <Button Content="保存数据库设置" Command="{Binding SaveDatabaseSettingsCommand}" MinWidth="128" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
