<Window x:Class="AcsMotionTool.App.Views.InitializationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACS 运动控制调试工具 · 初始化"
        Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F9FC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="#1F3A5F" />
            <TextBlock Text="{Binding SubTitle}" FontSize="14" Foreground="#5A6B7B" Margin="0,4,0,0" />
            <Separator Margin="0,14,0,0" />
        </StackPanel>

        <!-- 步骤与状态 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="#5A6B7B">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9AA7B4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter Property="Foreground" Value="#E08A00" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Success">
                                                <Setter Property="Foreground" Value="#1B7F32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Foreground" Value="#B3261E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                <Setter Property="Foreground" Value="#8A7B3A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="#5A6B7B"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 右侧状态卡片 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"
                    BorderBrush="#DDE4EC" BorderThickness="1" VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="初始化状态" FontSize="12" Foreground="#5A6B7B" />
                    <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F3A5F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="#1B7F32" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                        <Setter Property="Foreground" Value="#B3261E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="{Binding IsBusy}" />

                    <TextBlock Text="{Binding StatusDetail}" FontSize="12.5" Foreground="#5A6B7B"
                               TextWrapping="Wrap" Margin="0,10,0,0" />

                    <TextBlock Text="提示:初始化会自动建库建表(acs_motion)，并从数据库加载各轴软限位。"
                               FontSize="11.5" Foreground="#8A97A4" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="用模拟器重试" Command="{Binding RetryWithSimulatorCommand}" MinWidth="120"
                    Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="重新初始化" Command="{Binding RetryCommand}" MinWidth="120"
                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            <Button Content="进入主界面" Command="{Binding EnterMainCommand}" MinWidth="150"
                    FontWeight="SemiBold" Padding="16,6"
                    IsEnabled="{Binding IsCompleted}" />
        </StackPanel>
    </Grid>
</Window>
