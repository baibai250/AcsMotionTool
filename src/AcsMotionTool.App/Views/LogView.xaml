<UserControl x:Class="AcsMotionTool.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:AcsMotionTool.App.Infrastructure"
             xmlns:core="clr-namespace:AcsMotionTool.Core;assembly=AcsMotionTool.Core">

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="日志" />
            <TextBlock Style="{StaticResource PageSubtitle}">
                <Run Text="全量操作日志 · 当前显示 " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text=" 条" />
            </TextBlock>
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,12" Padding="12,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SegRadioGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegRadio}" Content="全部" GroupName="LogLevel"
                                         IsChecked="{Binding LevelFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource SegRadio}" Content="信息" GroupName="LogLevel"
                                         IsChecked="{Binding LevelFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource SegRadio}" Content="警告" GroupName="LogLevel"
                                         IsChecked="{Binding LevelFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}" />
                            <RadioButton Style="{StaticResource SegRadio}" Content="错误" GroupName="LogLevel"
                                         IsChecked="{Binding LevelFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Muted}" Text="搜索" Margin="16,0,6,0" VerticalAlignment="Center" />
                    <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按内容/来源模糊过滤" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}" Margin="0,0,12,0" />
                    <Button Content="清空日志" Command="{Binding ClearCommand}" Style="{StaticResource ButtonSmall}" Margin="0,0,8,0" />
                    <Button Content="保存到文件" Command="{Binding SaveCommand}" Style="{StaticResource ButtonSmall}" MinWidth="104" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Height="30">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderCell}" Text="时间" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderCell}" Text="级别" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderCell}" Text="来源" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderCell}" Text="内容" />
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding ItemsView}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         infra:AutoScrollBehavior.IsEnabled="{Binding AutoScroll}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:AcsLogLevel.Warn}">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFBF3" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:AcsLogLevel.Error}">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFFEF6F5" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss.fff}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" />

                                <Border Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static core:AcsLogLevel.Warn}">
                                                    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="#FFF2DDBC" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static core:AcsLogLevel.Error}">
                                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="#FFF3CEC9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LevelText}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static core:AcsLogLevel.Warn}">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static core:AcsLogLevel.Error}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11.5"
                                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12.5"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
