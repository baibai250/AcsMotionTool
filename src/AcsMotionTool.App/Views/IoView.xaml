<UserControl x:Class="AcsMotionTool.App.Views.IoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="IO" />
            <TextBlock Style="{StaticResource PageSubtitle}">
                <Run Text="数字输入监视 · 点击输出位即写硬件 · " />
                <Run Text="{Binding LayoutText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- 输入 / 输出 -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 数字输入 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="数字输入" />
                            <TextBlock Style="{StaticResource Muted}" Text="只读 · 随轮询刷新"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <ItemsControl ItemsSource="{Binding InputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,0,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Padding="12,7"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding HexText}" HorizontalAlignment="Right"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Foreground="{StaticResource Text3Brush}" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Bits}" Margin="8,6" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource LedToggle}"
                                                                      Content="{Binding Bit}"
                                                                      IsChecked="{Binding IsOn, Mode=OneWay}"
                                                                      IsHitTestVisible="False" Focusable="False" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 数字输出 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="数字输出" />
                            <TextBlock Style="{StaticResource Muted}" Text="点击位 = 立即写硬件"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <ItemsControl ItemsSource="{Binding OutputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,0,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Padding="12,7"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding HexText}" HorizontalAlignment="Right"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Foreground="{StaticResource Text3Brush}" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Bits}" Margin="8,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource LedToggle}"
                                                                      Content="{Binding Bit}"
                                                                      IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                      ToolTip="点击切换该输出位" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 整端口 / 模拟量 -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CardTitle}" Text="整端口与模拟量" />
                        <TextBlock Style="{StaticResource Muted}" Text="端口号对上面两组同时生效"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <WrapPanel Margin="14,10" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="端口号" />
                        <TextBox Width="72" Margin="0,4,0,0"
                                 Text="{Binding PortNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="输出值（十进制或 0x）" />
                        <TextBox Width="120" Margin="0,4,0,0"
                                 Text="{Binding PortValueText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button VerticalAlignment="Bottom" Content="写整个端口" Command="{Binding WritePortCommand}"
                            Style="{StaticResource ButtonPrimary}" Margin="0,0,22,0" MinWidth="110" />

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="模拟输出值" />
                        <TextBox Width="110" Margin="0,4,0,0"
                                 Text="{Binding AnalogValueText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button VerticalAlignment="Bottom" Content="写模拟量" Command="{Binding WriteAnalogCommand}" Margin="0,0,8,0" />
                    <Button VerticalAlignment="Bottom" Content="读模拟输入" Command="{Binding ReadAnalogCommand}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding AnalogResultText}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
